---
import Base from '../layouts/Base.astro';
import I from '../components/Icons.astro';
import Univers from '../components/Univers.astro';
import { u, asset } from '../lib/url.js';
import { STATIONS, UNIVERS } from '../lib/stations.js';
// Textes repris de la page « Nos radios » du site actuel
const TXT = [
  'Créée en 2007, Radio Monaco est une radio musicale qui diffuse également des news et des émissions thématiques. En FM, les fréquences 95.4, 98.2 et 103.2 couvrent un territoire entre Bordighera et Saint-Tropez. En DAB+, Radio Monaco propose une qualité numérique pour Paris et Nice.',
  'Les programmes de Radio Monaco et l’actualité francilienne, en DAB+ à Paris et partout sur le site et l’appli.',
  'Chaque jour, toute la team DJ de Radio Monaco avec des sets nu-disco, house, deep-house, future-soul et electro-pop.',
  'La programmation musicale de nuit, disponible 24 h/24 : house, pop, urban pop et chill-out, une sélection tendance pour plonger dans une expérience nocturne.'
];
const UTXT = TXT;
const PROD = (process.env.PROD_URL || 'https://radio-monaco.com').replace(/\/$/, '');
const ld = { '@context': 'https://schema.org', '@type': 'ItemList', name: 'Les radios de Radio Monaco', itemListElement: STATIONS.map((s, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'RadioChannel', name: 'Radio Monaco ' + s.name, broadcastChannelId: s.bands.map((b) => b.f).join(', '), url: PROD + '/nos-radios/#' + s.key } })) };
---
<Base title="Nos radios — Radio Monaco" description="Monte-Carlo, Paris, 100 % Mix DJ et Night Mood : les quatre radios de Radio Monaco en FM, DAB+ et en ligne." path="/nos-radios/" jsonld={[ld]}>
  <Univers h1 eyebrow="Nos radios" id="univers" />
  <span data-dock-glass hidden></span>

  <section class="ou" data-reveal data-snap>
    <div class="wrap">
      <div class="ou-hd">
        <p class="eb">Où nous écouter</p>
        <h2 class="ou-h"><span class="m"><span>Partout,</span></span> <span class="m"><span style="font-weight:600">tout le temps.</span></span></h2>
        <p class="ou-lead">En FM de Bordighera à Saint-Tropez, en DAB+ à Monaco, Nice et Paris, et partout dans le monde sur le site et l’appli.</p>
      </div>
      <div class="ou-grid ou-vl">
        {UNIVERS.map((s, g) => (
          <article class:list={['ou-st rise', { 'ou-g': s.departs, on: g === 0 }]} id={s.key} style={`--c:${s.color};--d:${(g * 0.08 + 0.1).toFixed(2)}s`}>
            <button class="ou-tg" type="button" aria-expanded={g === 0 ? 'true' : 'false'} aria-controls={'ou-b-' + s.key}>
              <img class="ou-lg" src={asset(s.logoInk)} alt={s.departs ? s.name : 'Radio Monaco ' + s.name} loading="lazy" />
              <span class="ou-line">{s.departs ? s.name : s.line}</span>
              <span class="ou-sum" aria-hidden="true">{[...new Set((s.departs ? s.departs.flatMap((d) => d.bands) : s.bands).map((b) => b.f === 'Web' ? 'Site & appli' : b.f))].map((f) => <i>{f}</i>)}</span>
              <span class="ou-pl" aria-hidden="true"></span>
            </button>
            <div class="ou-body" id={'ou-b-' + s.key}>
            <p class="ou-tx">{UTXT[g]}</p>
            {s.departs ? s.departs.map((d) => (
              <div class="ou-dep">
                <p class="ou-dn">Départ {d.name}{d.note && <span>{d.note}</span>}</p>
                <ul class="ou-fq">{d.bands.map((b) => <li><span>{b.city || (b.f === 'DAB+' ? 'Numérique' : 'En ligne')}</span><b>{b.f === 'Web' ? 'Site & appli' : b.f}</b></li>)}</ul>
                <button class="ou-play" type="button" data-rm-live={d.i} data-rm-st={d.i}><span class="pi"><I n="pp" /></span><span data-ou-l data-ou-n={d.name}>Écouter {d.name}</span></button>
              </div>
            )) : (
              <>
                <ul class="ou-fq">{s.bands.map((b) => <li><span>{b.city || (b.f === 'DAB+' ? 'Numérique' : 'En ligne')}</span><b>{b.f === 'Web' ? 'Site & appli' : b.f}</b></li>)}</ul>
                <p class="ou-now" data-now={s.ids[0]}></p>
                <button class="ou-play" type="button" data-rm-live={s.ids[0]} data-rm-st={s.ids[0]}><span class="pi"><I n="pp" /></span><span data-ou-l>Écouter</span></button>
              </>
            )}
            {s.departs && <p class="ou-now" data-now={s.ids[0]}></p>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <script src="../scripts/home.js"></script>
  <script>
    // titre en cours et état de lecture de chaque radio
    const paint = () => {
      const R = window.RM; if (!R) return; const m = R.meta || {}, s = R.state;
      document.querySelectorAll('[data-now]').forEach((el) => { const x = m[+el.dataset.now]; el.textContent = x && x.title ? 'En ce moment · ' + x.title + (x.artist ? ' — ' + x.artist : '') : ''; });
      document.querySelectorAll('[data-rm-st]').forEach((b) => { const on = s.mode === 'live' && s.station === +b.dataset.rmSt && s.playing; b.classList.toggle('playing', on); const l = b.querySelector('[data-ou-l]'); l.textContent = on ? 'En écoute' : 'Écouter' + (l.dataset.ouN ? ' ' + l.dataset.ouN : ''); });
    };
    ['rm:meta', 'rm:state', 'astro:page-load'].forEach((e) => document.addEventListener(e, paint)); paint();
    // volets « Où nous écouter » : un seul ouvert à la fois, au survol (ordinateur), au toucher ou au clavier
    const volets = () => {
      const vl = document.querySelector('.ou-vl'); if (!vl || vl.dataset.ok) return; vl.dataset.ok = '1';
      const items = [...vl.children]; const wide = matchMedia('(min-width: 901px)');
      const open = (el) => items.forEach((x) => { const on = x === el; x.classList.toggle('on', on); x.querySelector('.ou-tg').setAttribute('aria-expanded', on ? 'true' : 'false'); });
      items.forEach((x) => {
        x.addEventListener('mouseenter', () => { if (wide.matches) open(x); });
        x.querySelector('.ou-tg').addEventListener('click', () => open(x));
        x.addEventListener('focusin', () => open(x));
      });
    };
    document.addEventListener('astro:page-load', volets); volets();
  </script>
</Base>
