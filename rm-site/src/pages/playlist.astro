---
// Playlists : deux univers entre lesquels on bascule.
//  - The Sound of Monte-Carlo (départs Monte-Carlo et Paris, même programme) : historique Infomaniak du flux Monte-Carlo ;
//  - Night Mood : historique Infomaniak du flux Night Mood, pochettes sous un voile violet.
import Base from '../layouts/Base.astro';
import { u, asset } from '../lib/url.js';
import { STATIONS } from '../lib/stations.js';
import { getPlaylist, metaId } from '../lib/data.js';
const mc = STATIONS[0], nm = STATIONS[3];
const snap = await getPlaylist([mc, nm]);
const dep = (i) => ({ i, name: STATIONS[i].name, logo: asset(STATIONS[i].logoInk), logoW: asset(STATIONS[i].logo) });
const radios = [
  { key: mc.key, sw: 'Monte-Carlo & Paris', name: 'The Sound of Monte-Carlo', h: ['The Sound of', 'Monte-Carlo.'], lead: 'La playlist Radio Monaco à découvrir sans modération.', color: mc.color, id: metaId(mc.stream), departs: [dep(0), dep(1)], mark: asset(mc.cover), logo: asset(mc.logoInk), note: 'Même playlist à Monte-Carlo et à Paris. Paris ajoute l’info de Paris et d’Île-de-France.' },
  { key: nm.key, sw: 'Night Mood', name: 'Night Mood', h: ['La playlist', 'Night Mood.'], lead: 'La sélection musicale nocturne de Radio Monaco.', color: nm.color, id: metaId(nm.stream), departs: [dep(3)], mark: asset(nm.cover), logo: asset(nm.logoInk), note: '' }
];
---
<Base title="The Sound of Monte-Carlo : la playlist — Radio Monaco" description="Les titres passés sur The Sound of Monte-Carlo, à Monte-Carlo et à Paris : heure de passage, artiste et pochette, mis à jour en direct." path="/playlist/">
  <div class="pl-bg" id="pl-bg" aria-hidden="true"></div>
  <div class="wrap pl-wrap">
    <header class="page-hd">
      <nav class="crumbs"><a href={u('/')}>Accueil</a><span class="sep">/</span><span>Playlist</span></nav>
      <h1 class="h1" id="pl-h1">The Sound of <b>Monte-Carlo.</b></h1>
      <p class="lead" id="pl-lead">La playlist Radio Monaco à découvrir sans modération.</p>
      <div class="pl-sw" role="tablist" aria-label="Choisir la playlist">
        {radios.map((r, i) => <button class:list={['pl-swb', { on: i === 0 }]} type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-pl-sw={r.key} style={`--c:${r.color}`}><i></i><span>{r.sw}</span></button>)}
      </div>
    </header>

    <div class="pl-bar">
      <label class="pl-q"><span class="sr">Rechercher un titre ou un artiste</span><svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" class="ic"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg><input type="search" id="pl-q" placeholder="Rechercher un titre ou un artiste" autocomplete="off" /></label>
    </div>

    <section class="pl-now" id="pl-now" aria-live="polite"></section>
    <div class="pl-list" id="pl-list"></div>
    <p class="pl-note">Les 100 derniers titres diffusés. L’heure est celle de Monaco.</p>
  </div>

  <script type="application/json" id="pl-data" set:html={JSON.stringify({ radios, snap }).replace(/</g, '\\u003c')}></script>
  <script>
    // ---------- playlist en direct ----------
    let stopPl = null;
    function initPlaylist() {
      if (stopPl) stopPl();
      const el = document.getElementById('pl-data'); if (!el) { stopPl = null; return; }
      const D = JSON.parse(el.textContent); const ac = new AbortController(); const sig = { signal: ac.signal }; let timer = 0;
      stopPl = () => { ac.abort(); clearInterval(timer); document.documentElement.classList.remove('pl-night'); };
      const cache = D.snap; const radio = () => D.radios.find((r) => r.key === cur) || D.radios[0];
      let cur = (D.radios.find((r) => '#' + r.key === location.hash) || D.radios[0]).key;
      const open = new Set(); // heures dépliées, conservées entre deux mises à jour

      // mise en forme : « DUA LIPA x X - TITRE » → artiste / titre, sans tout en capitales
      const esc = (s) => String(s || '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
      const nice1 = (s) => { s = (s || '').replace(/\s+/g, ' ').trim(); const l = s.replace(/[^A-Za-zÀ-ÿ]/g, ''); const up = l.replace(/[^A-ZÀ-Þ]/g, '').length; if (l.length && up / l.length > 0.6) s = s.toLowerCase().replace(/(^|[\s(\-&/"«])([a-zà-ÿ])/g, (m, a, b) => a + b.toUpperCase()); return s.replace(/ (Feat|Ft)\.? /gi, ' feat. ').replace(/ X /g, ' x ').replace(/ Vs\.? /gi, ' vs '); };
const nice = (x) => { const k = (x || '').indexOf(' ('); return k > 0 ? nice1(x.slice(0, k)) + ' ' + nice1(x.slice(k + 1)) : nice1(x); };
      const parse = ([date, dur, raw, cover]) => { const i = raw.indexOf(' - '); const artist = i > 0 ? raw.slice(0, i) : ''; const title = i > 0 ? raw.slice(i + 3) : raw; return { date, dur, raw, cover, artist: nice(artist), title: nice(title) }; };
      const junk = (t) => !t.title || /^radio monaco$/i.test(t.title) || /^radio monaco$/i.test(t.artist) || (t.dur && t.dur < 45 && !t.artist);

      // heure de Monaco
      const fT = new Intl.DateTimeFormat('fr-FR', { timeZone: 'Europe/Monaco', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
      const fD = new Intl.DateTimeFormat('fr-FR', { timeZone: 'Europe/Monaco', year: 'numeric', month: '2-digit', day: '2-digit' });
      const fW = new Intl.DateTimeFormat('fr-FR', { timeZone: 'Europe/Monaco', weekday: 'long', day: 'numeric', month: 'long' });
      const hhmm = (s) => fT.format(new Date(s * 1000));
      const dayLabel = (s) => { const d = fD.format(new Date(s * 1000)), t = fD.format(new Date()), y = fD.format(new Date(Date.now() - 864e5)); return d === t ? '' : d === y ? 'Hier' : fW.format(new Date(s * 1000)).replace(/^./, (c) => c.toUpperCase()); };

      // pochettes manquantes : recherche iTunes, au fil du défilement, mémorisée pour la session
      let store = {}; try { store = JSON.parse(sessionStorage.getItem('rm-covers') || '{}'); } catch (e) {}
      const save = () => { try { sessionStorage.setItem('rm-covers', JSON.stringify(store)); } catch (e) {} };
      const queue = []; let busy = 0;
      const lookup = (t, low) => new Promise((res) => { if (low) queue.push([t, res]); else queue.unshift([t, res]); pump(); });
      const pump = () => {
        while (busy < 2 && queue.length) {
          const [t, res] = queue.shift(); busy++;
          const q = encodeURIComponent((t.artist.split(/ x | feat\. | & | vs |, /i)[0] + ' ' + t.title).replace(/\(.*?\)|\[.*?\]/g, ' ').replace(/\s+/g, ' ').trim());
          fetch('https://itunes.apple.com/search?media=music&entity=song&limit=1&country=fr&term=' + q, sig).then((r) => r.json()).then((j) => { const a = j.results && j.results[0] && j.results[0].artworkUrl100; store[t.raw] = a ? a.replace('100x100', '300x300') : ''; save(); res(store[t.raw]); }).catch(() => res('')).finally(() => { busy--; setTimeout(pump, 250); });
        }
      };
      const io = 'IntersectionObserver' in window ? new IntersectionObserver((es) => es.forEach((e) => {
        if (!e.isIntersecting) return; io.unobserve(e.target); const img = e.target; const t = { raw: img.dataset.raw, artist: img.dataset.a, title: img.dataset.t };
        const set = (src) => { if (src) { img.src = src; img.removeAttribute('data-need'); schedBg(); } };
        if (store[t.raw] !== undefined) { set(store[t.raw]); return; }
        lookup(t).then(set);
      }), { rootMargin: '300px 0px' }) : null;
      const coverOf = (t) => t.cover || store[t.raw] || '';
      const img = (t, cls) => { const src = coverOf(t); return `<img class="${cls}" src="${esc(src || radio().mark)}" alt="" loading="lazy" ${src ? '' : `data-need data-raw="${esc(t.raw)}" data-a="${esc(t.artist)}" data-t="${esc(t.title)}"`} />`; };

      // ---------- fond : mosaïque des pochettes passées à l'antenne ----------
      const B = document.getElementById('pl-bg'); let bgCols = '', shown = new Set(), bgT = 0;
      const bgCovers = () => { const seen = new Set(), out = []; (cache[cur] || []).map(parse).sort((a, b) => b.date - a.date).forEach((t) => { const c = t.cover || store[t.raw]; if (c && !seen.has(c)) { seen.add(c); out.push(c); } }); return out; };
      const paintBg = () => {
        if (!B) return; const C = bgCovers();
        // mosaïque sur toute la largeur ; un voile la rend presque opaque derrière la colonne de texte
        const vw = document.documentElement.clientWidth;
        const wrap = document.querySelector('.pl-wrap'); const cw = wrap ? Math.min(vw, wrap.getBoundingClientRect().width) : 980;
        const n = C.length < 8 ? 0 : Math.max(3, Math.min(14, Math.round(vw / 185)));
        const key = n + ':' + vw + ':' + Math.ceil(innerHeight / 150);
        if (key !== bgCols) {
          bgCols = key; B.style.setProperty('--cw', Math.round(cw) + 'px'); B.style.setProperty('--n', n);
          if (!n) { B.innerHTML = ''; return; }
          // chaque colonne couvre toute la hauteur à tout moment du défilement (pochettes répétées si besoin),
          // avec un point de départ différent par colonne
          shown = new Set(C); const per = Math.max(1, Math.ceil(C.length / n));
          const gap = vw < 640 ? 10 : 14, cwid = (vw - 2 * gap - (n - 1) * gap) / n, cell = cwid + gap, need = Math.ceil((innerHeight + 160) / cell) + 1;
          let h = '';
          for (let c = 0; c < n; c++) { const len = Math.max(per, need), set = []; for (let k = 0; k < len; k++) set.push(C[(c * per + k) % C.length]); const t = 240 + (c % 3) * 60; h += `<div class="pl-bgc" style="--t:${t}s;--ph:-${(((c * 0.37) % 1) * t).toFixed(1)}s">${[...set, ...set].map((x) => `<img src="${esc(x)}" alt="" decoding="async">`).join('')}</div>`; }
          B.innerHTML = h;
          const cx = innerWidth / 2, cy = innerHeight / 2, ims = [...B.querySelectorAll('img')];
          const ds = ims.map((i) => { const r = i.getBoundingClientRect(); return Math.hypot(r.left + r.width / 2 - cx, r.top + r.height / 2 - cy); });
          const min = Math.min(...ds), span = Math.max(1, Math.min(innerWidth * 0.75, Math.max(...ds)) - min);
          ims.forEach((i, k) => { i.style.setProperty('--dl', Math.min(2.2, ((ds[k] - min) / span) * 1.8).toFixed(2) + 's'); reveal(i); });
          setTimeout(settle, 4500);
          return;
        }
        if (!n) return;
        // nouveaux titres : leur pochette remplace une case au hasard, en fondu
        const cols = B.querySelectorAll('.pl-bgc');
        C.filter((x) => !shown.has(x)).slice(0, 6).forEach((x) => {
          shown.add(x); const colEl = cols[Math.floor(Math.random() * cols.length)]; if (!colEl) return;
          const im = colEl.children, half = im.length / 2, k = Math.floor(Math.random() * half);
          [im[k], im[k + half]].forEach((el) => { if (!el) return; el.style.setProperty('--dl', '0s'); el.classList.remove('in'); void el.offsetWidth; el.src = x; reveal(el); });
        });
      };
      // garde-fou : si le navigateur n'a pas joué l'animation (onglet en veille…), on affiche directement
      const settle = () => { B.querySelectorAll('img.in').forEach((i) => { if (+getComputedStyle(i).opacity < 0.5) i.classList.add('done'); }); };
      const reveal = (i) => { const go = () => i.classList.add('in'); if (i.complete && i.naturalWidth) go(); else i.addEventListener('load', go, { once: true }); };

      const schedBg = () => { clearTimeout(bgT); bgT = setTimeout(paintBg, 600); };
      window.addEventListener('resize', schedBg, sig);
      let warmed = false;
      const warm = () => { if (warmed) return; warmed = true; (cache[cur] || []).map(parse).filter((t) => !junk(t) && !t.cover && store[t.raw] === undefined).sort((a, b) => b.date - a.date).slice(0, 30).forEach((t) => lookup(t, true).then(schedBg)); };

      const q = document.getElementById('pl-q');
      const row = (t, day) => `<li class="pl-r"><time class="pl-t" datetime="${new Date(t.date * 1000).toISOString()}">${hhmm(t.date)}</time>${img(t, 'pl-c')}<span class="pl-x"><span class="pl-tt">${esc(t.title)}</span><span class="pl-a">${esc(t.artist)}${day && dayLabel(t.date) ? ' · ' + esc(dayLabel(t.date)) : ''}</span></span></li>`;
      // un bouton d'écoute par départ, avec son logo
      const listen = (r) => r.departs.map((d) => `<button class="pl-dep" type="button" data-rm-live="${d.i}" style="--c:${r.color}" aria-label="Écouter ${esc(d.name)}"><span class="pi"><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></span><img class="k" src="${esc(d.logo)}" alt="" /><img class="w" src="${esc(d.logoW)}" alt="" /></button>`).join('') + (r.note ? `<p class="pl-dn">${esc(r.note)}</p>` : '');
      const draw = () => {
        const r = radio(); if (!r) return;
        const all = (cache[cur] || []).map(parse).filter((t) => !junk(t)).sort((a, b) => b.date - a.date);
        const now = all[0] && !all[0].dur ? all[0] : null; // le titre en cours n'a pas encore de durée
        const term = (q.value || '').trim().toLowerCase();
        const past = all.filter((t) => t !== now);
        const N = document.getElementById('pl-now'), L = document.getElementById('pl-list');
        N.style.setProperty('--c', r.color);
        N.innerHTML = now && !term ? `${img(now, 'pl-nc')}<div class="pl-nx"><span class="pl-nk"><span class="live-dot"></span><span>En ce moment</span><i>depuis ${hhmm(now.date)}</i></span><span class="pl-nt">${esc(now.title)}</span><span class="pl-na">${esc(now.artist)}</span></div><div class="pl-nb">${listen(r)}</div>` : '';
        N.hidden = !(now && !term);
        if (!all.length) { L.innerHTML = `<p class="pl-empty">La playlist n’est pas disponible pour le moment.</p>`; return; }
        if (term) {
          const hits = past.filter((t) => (t.artist + ' ' + t.title).toLowerCase().includes(term));
          L.innerHTML = hits.length ? `<h2 class="pl-h">${hits.length} titre${hits.length > 1 ? 's' : ''} trouvé${hits.length > 1 ? 's' : ''}</h2><ol class="pl-ol">${hits.map((t) => row(t, true)).join('')}</ol>` : `<p class="pl-empty">Aucun titre ne correspond à « ${esc(q.value.trim())} » dans les 100 derniers titres.</p>`;
        } else {
          // les 10 derniers titres, puis les heures précédentes regroupées
          const last = past.slice(0, 10), older = past.slice(10);
          let html = `<h2 class="pl-h">Les 10 derniers titres</h2><ol class="pl-ol">${last.map((t) => row(t, true)).join('')}</ol>`;
          const groups = [];
          older.forEach((t) => { const day = dayLabel(t.date), h = hhmm(t.date).slice(0, 2), key = day + '|' + h; const g = groups[groups.length - 1]; if (g && g.key === key) g.items.push(t); else groups.push({ key, day, h: +h, items: [t] }); });
          if (groups.length) html += `<h2 class="pl-h pl-h2">Plus tôt</h2>` + groups.map((g) => `<details class="pl-g" data-k="${esc(g.key)}"${open.has(g.key) ? ' open' : ''}><summary><span class="pl-gh">${g.day ? esc(g.day) + ', ' : ''}${g.h}h</span><span class="pl-gn">${g.items.length} titre${g.items.length > 1 ? 's' : ''}</span><span class="pl-gv" aria-hidden="true"></span></summary><ol class="pl-ol">${g.items.map((t) => row(t, false)).join('')}</ol></details>`).join('');
          L.innerHTML = html;
          L.querySelectorAll('details.pl-g').forEach((d) => d.addEventListener('toggle', () => { if (d.open) { open.add(d.dataset.k); d.querySelectorAll('img[data-need]').forEach((i) => io && io.observe(i)); } else open.delete(d.dataset.k); }));
        }
        if (io) document.querySelectorAll('#pl-list .pl-ol img[data-need], #pl-now img[data-need]').forEach((i) => { if (!i.closest('details:not([open])')) io.observe(i); });
        schedBg();
      };

      const load = async () => {
        const r = radio(); if (!r) return;
        const k = cur;
        try { const res = await fetch(`https://metadata.infomaniak.com/api/radio/${r.id}/metadata-all-cover`, { cache: 'no-store', ...sig }); const j = await res.json(); if (Array.isArray(j.data)) cache[k] = j.data.map((x) => [x.date, x.duration || 0, x.title || '', x.cover || '']); } catch (e) {}
        if (k !== cur) return;
        draw(); setTimeout(warm, 2500);
      };
      // bascule d'univers : The Sound of Monte-Carlo ↔ Night Mood
      const skin = () => { const r = radio(); const nmode = r.key === 'nightmood';
        document.querySelector('.pl-wrap').classList.toggle('nm', nmode); if (B) B.classList.toggle('nm', nmode); document.documentElement.classList.toggle('pl-night', nmode);
        document.querySelector('.pl-wrap').style.setProperty('--c', r.color);
        document.getElementById('pl-h1').innerHTML = esc(r.h[0]) + ' <b>' + esc(r.h[1]) + '</b>'; document.getElementById('pl-lead').textContent = r.lead;
        document.querySelectorAll('[data-pl-sw]').forEach((b) => { const on = b.dataset.plSw === r.key; b.classList.toggle('on', on); b.setAttribute('aria-selected', on ? 'true' : 'false'); }); };
      document.querySelectorAll('[data-pl-sw]').forEach((b) => b.addEventListener('click', () => {
        if (b.dataset.plSw === cur) return; cur = b.dataset.plSw; open.clear(); warmed = false; bgCols = ''; q.value = '';
        history.replaceState(history.state, '', cur === D.radios[0].key ? location.pathname : '#' + cur);
        skin(); draw(); load();
      }, sig));
      skin();
      q.addEventListener('input', draw, sig);
      document.addEventListener('visibilitychange', () => { if (!document.hidden) load(); }, sig);
      timer = setInterval(() => { if (!document.hidden) load(); }, 30000);
      draw(); load();
    }
    document.addEventListener('astro:page-load', initPlaylist);
    document.addEventListener('astro:before-swap', () => { if (stopPl) { stopPl(); stopPl = null; } });
  </script>
</Base>
