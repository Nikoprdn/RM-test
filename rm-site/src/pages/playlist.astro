---
// Playlist : les titres passés sur chaque radio (historique Infomaniak), heure de passage, titre, artiste, pochette.
import Base from '../layouts/Base.astro';
import { u, asset } from '../lib/url.js';
import { STATIONS } from '../lib/stations.js';
import { getPlaylist, metaId } from '../lib/data.js';
const snap = await getPlaylist(STATIONS);
const radios = STATIONS.map((s, i) => ({ i, key: s.key, name: s.name, color: s.color, id: metaId(s.stream), has: (snap[s.key] || []).length > 0 }));
// Paris n'a pas d'historique chez Infomaniak : son onglet n'apparaît que si des titres arrivent
const shown = radios.filter((r) => r.has || r.key !== 'paris');
---
<Base title="Playlist — Radio Monaco" description="Les titres passés sur Radio Monaco, 100 % Mix DJ et Night Mood : heure de passage, artiste et pochette, mis à jour en direct." path="/playlist/">
  <div class="wrap pl-wrap">
    <header class="page-hd">
      <nav class="crumbs"><a href={u('/')}>Accueil</a><span class="sep">/</span><span>Playlist</span></nav>
      <h1 class="h1">La <b>playlist.</b></h1>
      <p class="lead">Les titres passés à l’antenne ces dernières heures, mis à jour en direct.</p>
    </header>

    <div class="pl-bar">
      <div class="pzt" role="tablist" aria-label="Choisir la radio">
        {shown.map((r, k) => <button role="tab" type="button" class:list={['pztb', { on: k === 0 }]} aria-selected={k === 0 ? 'true' : 'false'} data-pl={r.key} style={`--c:${r.color}`}>{r.name}</button>)}
      </div>
      <label class="pl-q"><span class="sr">Rechercher un titre ou un artiste</span><svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" class="ic"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg><input type="search" id="pl-q" placeholder="Rechercher un titre ou un artiste" autocomplete="off" /></label>
    </div>

    <section class="pl-now" id="pl-now" aria-live="polite"></section>
    <div class="pl-list" id="pl-list"></div>
    <p class="pl-note">Les 100 derniers titres de chaque radio. L’heure est celle de Monaco.</p>
  </div>

  <script type="application/json" id="pl-data" set:html={JSON.stringify({ radios, snap, mark: asset('rm-mark.png') }).replace(/</g, '\\u003c')}></script>
  <script>
    // ---------- playlist en direct ----------
    let stopPl = null;
    function initPlaylist() {
      if (stopPl) stopPl();
      const el = document.getElementById('pl-data'); if (!el) { stopPl = null; return; }
      const D = JSON.parse(el.textContent); const ac = new AbortController(); const sig = { signal: ac.signal }; let timer = 0;
      stopPl = () => { ac.abort(); clearInterval(timer); };
      const cache = D.snap; const tabs = [...document.querySelectorAll('[data-pl]')];
      let cur = (location.hash.slice(1) && tabs.some((t) => t.dataset.pl === location.hash.slice(1))) ? location.hash.slice(1) : (tabs[0] && tabs[0].dataset.pl);
      const radio = () => D.radios.find((r) => r.key === cur);

      // mise en forme : « DUA LIPA x X - TITRE » → artiste / titre, sans tout en capitales
      const esc = (s) => String(s || '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
      const nice = (s) => { s = (s || '').replace(/\s+/g, ' ').trim(); const l = s.replace(/[^A-Za-zÀ-ÿ]/g, ''); const up = l.replace(/[^A-ZÀ-Þ]/g, '').length; if (l.length && up / l.length > 0.6) s = s.toLowerCase().replace(/(^|[\s(\-&/"'«])([a-zà-ÿ])/g, (m, a, b) => a + b.toUpperCase()); return s.replace(/ (Feat|Ft)\.? /gi, ' feat. ').replace(/ X /g, ' x ').replace(/ Vs\.? /gi, ' vs '); };
      const parse = ([date, dur, raw, cover]) => { const i = raw.indexOf(' - '); const artist = i > 0 ? raw.slice(0, i) : ''; const title = i > 0 ? raw.slice(i + 3) : raw; return { date, dur, raw, cover, artist: nice(artist), title: nice(title) }; };
      const junk = (t) => !t.title || /^radio monaco$/i.test(t.title) || /^radio monaco$/i.test(t.artist) || (t.dur && t.dur < 45 && !t.artist);

      // heure de Monaco
      const fT = new Intl.DateTimeFormat('fr-FR', { timeZone: 'Europe/Monaco', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
      const fD = new Intl.DateTimeFormat('fr-FR', { timeZone: 'Europe/Monaco', year: 'numeric', month: '2-digit', day: '2-digit' });
      const fW = new Intl.DateTimeFormat('fr-FR', { timeZone: 'Europe/Monaco', weekday: 'long', day: 'numeric', month: 'long' });
      const hhmm = (s) => fT.format(new Date(s * 1000));
      const dayLabel = (s) => { const d = fD.format(new Date(s * 1000)), t = fD.format(new Date()), y = fD.format(new Date(Date.now() - 864e5)); return d === t ? '' : d === y ? 'Hier' : fW.format(new Date(s * 1000)).replace(/^./, (c) => c.toUpperCase()); };

      // pochettes manquantes : recherche iTunes, au fil du défilement, mémorisée pour la session
      let store = {}; try { store = JSON.parse(sessionStorage.getItem('rm-covers') || '{}'); } catch (e) {}
      const save = () => { try { sessionStorage.setItem('rm-covers', JSON.stringify(store)); } catch (e) {} };
      const queue = []; let busy = 0;
      const lookup = (t) => new Promise((res) => { queue.push([t, res]); pump(); });
      const pump = () => {
        while (busy < 2 && queue.length) {
          const [t, res] = queue.shift(); busy++;
          const q = encodeURIComponent((t.artist.split(/ x | feat\. | & | vs |, /i)[0] + ' ' + t.title).replace(/\(.*?\)|\[.*?\]/g, ' ').replace(/\s+/g, ' ').trim());
          fetch('https://itunes.apple.com/search?media=music&entity=song&limit=1&country=fr&term=' + q, sig).then((r) => r.json()).then((j) => { const a = j.results && j.results[0] && j.results[0].artworkUrl100; store[t.raw] = a ? a.replace('100x100', '300x300') : ''; save(); res(store[t.raw]); }).catch(() => res('')).finally(() => { busy--; setTimeout(pump, 250); });
        }
      };
      const io = 'IntersectionObserver' in window ? new IntersectionObserver((es) => es.forEach((e) => {
        if (!e.isIntersecting) return; io.unobserve(e.target); const img = e.target; const t = { raw: img.dataset.raw, artist: img.dataset.a, title: img.dataset.t };
        const set = (src) => { if (src) { img.src = src; img.removeAttribute('data-need'); } };
        if (store[t.raw] !== undefined) { set(store[t.raw]); return; }
        lookup(t).then(set);
      }), { rootMargin: '300px 0px' }) : null;
      const coverOf = (t) => t.cover || store[t.raw] || '';
      const img = (t, cls) => { const src = coverOf(t); return `<img class="${cls}" src="${esc(src || D.mark)}" alt="" loading="lazy" ${src ? '' : `data-need data-raw="${esc(t.raw)}" data-a="${esc(t.artist)}" data-t="${esc(t.title)}"`} />`; };

      const q = document.getElementById('pl-q');
      const draw = () => {
        const r = radio(); if (!r) return;
        const all = (cache[cur] || []).map(parse).filter((t) => !junk(t)).sort((a, b) => b.date - a.date);
        const now = all[0] && !all[0].dur ? all[0] : null; // le titre en cours n'a pas encore de durée
        const term = (q.value || '').trim().toLowerCase();
        const rest = all.filter((t) => t !== now && (!term || (t.artist + ' ' + t.title).toLowerCase().includes(term)));
        const N = document.getElementById('pl-now'), L = document.getElementById('pl-list');
        N.style.setProperty('--c', r.color);
        N.innerHTML = now && !term ? `${img(now, 'pl-nc')}<div class="pl-nx"><span class="pl-nk"><span class="live-dot"></span><span>En ce moment<span class="pl-on"> sur ${esc(r.name)}</span></span><i>depuis ${hhmm(now.date)}</i></span><span class="pl-nt">${esc(now.title)}</span><span class="pl-na">${esc(now.artist)}</span></div><button class="btn-play" type="button" data-rm-live="${r.i}" style="--c:${r.color}"><span class="pi"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></span>Écouter ${esc(r.name)}</button>` : '';
        N.hidden = !(now && !term);
        if (!all.length) { L.innerHTML = `<p class="pl-empty">La playlist de ${esc(r.name)} n’est pas disponible pour le moment.</p>`; return; }
        if (!rest.length) { L.innerHTML = `<p class="pl-empty">Aucun titre ne correspond à « ${esc(q.value.trim())} » dans les 100 derniers titres.</p>`; return; }
        let html = '', grp = '';
        rest.forEach((t) => {
          const day = dayLabel(t.date), h = hhmm(t.date).slice(0, 2), key = day + h;
          if (key !== grp) { if (grp) html += '</ol>'; grp = key; html += `<h2 class="pl-h">${day ? esc(day) + ', ' : ''}${+h}h</h2><ol class="pl-ol">`; }
          html += `<li class="pl-r"><time class="pl-t" datetime="${new Date(t.date * 1000).toISOString()}">${hhmm(t.date)}</time>${img(t, 'pl-c')}<span class="pl-x"><span class="pl-tt">${esc(t.title)}</span><span class="pl-a">${esc(t.artist)}</span></span></li>`;
        });
        L.innerHTML = html + '</ol>';
        if (io) document.querySelectorAll('#pl-list img[data-need], #pl-now img[data-need]').forEach((i) => io.observe(i));
      };

      const load = async () => {
        const r = radio(); if (!r) return;
        try { const res = await fetch(`https://metadata.infomaniak.com/api/radio/${r.id}/metadata-all-cover`, { cache: 'no-store', ...sig }); const j = await res.json(); if (Array.isArray(j.data)) cache[cur] = j.data.map((x) => [x.date, x.duration || 0, x.title || '', x.cover || '']); } catch (e) {}
        draw();
      };
      const pick = (k) => {
        cur = k; tabs.forEach((t) => { const on = t.dataset.pl === k; t.classList.toggle('on', on); t.setAttribute('aria-selected', on ? 'true' : 'false'); });
        history.replaceState(history.state, '', '#' + k); draw(); load();
      };
      tabs.forEach((t) => t.addEventListener('click', () => pick(t.dataset.pl), sig));
      q.addEventListener('input', draw, sig);
      document.addEventListener('visibilitychange', () => { if (!document.hidden) load(); }, sig);
      timer = setInterval(() => { if (!document.hidden) load(); }, 30000);
      pick(cur);
    }
    document.addEventListener('astro:page-load', initPlaylist);
    document.addEventListener('astro:before-swap', () => { if (stopPl) { stopPl(); stopPl = null; } });
  </script>
</Base>
