---
import Base from '../layouts/Base.astro';
import I from '../components/Icons.astro';
import { u } from '../lib/url.js';
import { getDJs } from '../lib/data.js';
const djs = await getDJs();
// la semaine des DJ sets : un bloc par jour, dans l'ordre de la semaine ; les sets sans horaire fixe à la fin
const groups = [];
djs.forEach((d) => { const k = d.slot ? d.slot.day : 'Selon les semaines'; let g = groups.find((x) => x.day === k); if (!g) groups.push((g = { day: k, items: [], n: 0 })); g.items.push(d); g.n++; });
---
<Base title="DJ sets — Radio Monaco" description="Les DJs résidents et invités de Radio Monaco : leurs sets, leurs horaires et 100 % Mix DJ en continu." path="/djs/">
  <div class="wrap">
    <header class="page-hd">
      <nav class="crumbs" aria-label="Fil d’Ariane"><a href={u('/')}>Accueil</a><span class="sep">/</span><span>DJ sets</span></nav>
      <h1 class="h1">Les DJs de <b>Radio Monaco.</b></h1>
      <p class="lead">Nu-disco, house, deep-house, future-soul : nos résidents et invités aux platines, et 100 % Mix DJ en continu.</p>
      <button class="btn-play" type="button" data-rm-live="2" style="--c:#F59C00;margin-top:28px"><span class="pi"><I n="play" /></span>Écouter 100 % Mix DJ</button>
    </header>
    {groups.map((g) => (
      <section class="djday">
        <h2 class="djd-h">{g.day}{g.n > 1 && <span>{g.n} sets</span>}</h2>
        <div class="people">{g.items.map((d) => <a class="person" href={u(d.path)}><span class="ph">{d.img && <img src={d.img.card} alt={d.name} loading="lazy" />}{d.slot && <span class="djb"><b>{d.slot.day}</b>{d.slot.time}</span>}</span><b>{d.show}</b><span>{d.name !== d.show ? d.name : ''}</span></a>)}</div>
      </section>
    ))}
    </div>
</Base>
