---
// DJ sets : un onglet par jour de la semaine, les sets du jour affichés en grand.
import Base from '../layouts/Base.astro';
import I from '../components/Icons.astro';
import { u } from '../lib/url.js';
import { getDJs } from '../lib/data.js';
const djs = await getDJs();
const JO = ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi', 'Dimanche'];
// un groupe par jour, dans l'ordre de la semaine ; les sets sans horaire fixe à la fin
const groups = [];
djs.forEach((d) => (d.slots.length ? d.slots : [null]).forEach((sl) => {
  const k = sl ? sl.day : 'Au fil des semaines';
  let g = groups.find((x) => x.day === k);
  if (!g) groups.push((g = { day: k, short: sl ? sl.day.slice(0, 3) : 'Invités', o: sl ? JO.indexOf(sl.day) : 9, items: [] }));
  g.items.push({ ...d, slot: sl });
}));
groups.sort((a, b) => a.o - b.o).forEach((g) => g.items.sort((a, b) => (a.slot ? a.slot.min : 0) - (b.slot ? b.slot.min : 0)));
---
<Base title="DJ sets — Radio Monaco" description="Les DJs résidents et invités de Radio Monaco : leurs sets, leurs horaires et 100 % Mix DJ en continu." path="/djs/">
  <div class="wrap dj">
    <header class="page-hd dj-hd">
      <div>
        <nav class="crumbs" aria-label="Fil d’Ariane"><a href={u('/')}>Accueil</a><span class="sep">/</span><span>DJ sets</span></nav>
        <h1 class="h1">Les DJs de <b>Radio Monaco.</b></h1>
        <p class="lead">Nu-disco, house, deep-house, future-soul : nos résidents et invités aux platines, et 100 % Mix DJ en continu.</p>
      </div>
      <button class="btn-play dj-play" type="button" data-rm-live="2" style="--c:#F59C00"><span class="pi"><I n="play" /></span>Écouter 100 % Mix DJ</button>
    </header>

    <div class="dj-tabs" role="tablist" aria-label="Les jours de la semaine">
      {groups.map((g, i) => (
        <button class="dj-tab" type="button" role="tab" id={'dj-t-' + i} aria-controls={'dj-p-' + i} aria-selected={i === 0 ? 'true' : 'false'} data-dj-tab={i} data-dj-o={g.o}>
          <b>{g.day}</b><span>{g.items.length} set{g.items.length > 1 ? 's' : ''}</span>
        </button>
      ))}
    </div>

    {groups.map((g, i) => (
      <div class="dj-panel" role="tabpanel" id={'dj-p-' + i} aria-labelledby={'dj-t-' + i} data-dj-panel={i} hidden={i !== 0}>
        {g.items.map((d) => (
          <a class="dj-c" href={u(d.path)}>
            <span class="dj-ph">{d.img && <img src={d.img.card} alt={d.name} loading="lazy" />}</span>
            <span class="dj-tx">
              {d.slot && <span class="dj-when">{d.slot.time}</span>}
              <b>{d.show}</b>
              <span class="dj-who">{d.name !== d.show ? d.name : 'DJ invité'}</span>
            </span>
          </a>
        ))}
      </div>
    ))}
  </div>

  <script>
    // Onglets des jours : on ouvre sur le jour en cours quand il a des sets.
    let stopDj = null;
    function initDjs() {
      if (stopDj) stopDj();
      const tabs = [...document.querySelectorAll('[data-dj-tab]')]; if (!tabs.length) { stopDj = null; return; }
      const ac = new AbortController(); const sig = { signal: ac.signal }; stopDj = () => ac.abort();
      const panels = [...document.querySelectorAll('[data-dj-panel]')];
      const show = (i) => {
        tabs.forEach((t, k) => { const on = k === i; t.classList.toggle('on', on); t.setAttribute('aria-selected', on ? 'true' : 'false'); });
        panels.forEach((p, k) => (p.hidden = k !== i));
      };
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => show(i), sig);
        t.addEventListener('keydown', (e) => {
          const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0; if (!d) return;
          e.preventDefault(); const n = (i + d + tabs.length) % tabs.length; show(n); tabs[n].focus();
        }, sig);
      });
      const todayO = (new Date().getDay() + 6) % 7; // lundi = 0
      const i = tabs.findIndex((t) => +t.dataset.djO === todayO);
      show(i >= 0 ? i : 0);
    }
    document.addEventListener('astro:page-load', initDjs);
    document.addEventListener('astro:before-swap', () => { if (stopDj) { stopDj(); stopDj = null; } });
  </script>
</Base>
