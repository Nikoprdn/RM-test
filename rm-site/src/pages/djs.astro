---
// DJ sets en volets photo, dans le même langage que « Nos radios » : un volet par set,
// on survole pour l'ouvrir. Classés dans l'ordre de la semaine.
import Base from '../layouts/Base.astro';
import I from '../components/Icons.astro';
import { u } from '../lib/url.js';
import { getDJs } from '../lib/data.js';
const djs = await getDJs();
const sets = djs.map((d) => ({
  ...d,
  days: d.slots.length ? d.slots.map((s) => s.day).join(' & ') : 'Au fil des semaines',
  time: d.slot ? d.slot.time : ''
}));
---
<Base title="DJ sets — Radio Monaco" description="Les DJs résidents et invités de Radio Monaco : leurs sets, leurs horaires et 100 % Mix DJ en continu." path="/djs/">
  <section class="djv-s" data-full data-reveal data-snap>
    <div class="djv-hd">
      <div>
        <p class="eb djv-eb">DJ sets</p>
        <h1 class="djv-h"><span class="m"><span>Les DJs de</span></span> <span class="m"><span><b>Radio Monaco.</b></span></span></h1>
      </div>
      <button class="btn-play djv-play" type="button" data-rm-live="2" style="--c:#F59C00"><span class="pi"><I n="play" /></span>Écouter 100 % Mix DJ</button>
    </div>

    <div class="djv-row">
      {sets.map((d, i) => (
        <article class="djv" style={`--d:${(i * 0.05 + 0.1).toFixed(2)}s`}>
          {d.img && <img class="djv-ph" src={d.img.card} alt="" loading={i < 4 ? 'eager' : 'lazy'} />}
          <span class="djv-sc" aria-hidden="true"></span>
          <span class="djv-bar" aria-hidden="true"></span>
          <a class="djv-hit" href={u(d.path)} aria-label={`${d.show}, ${d.name}`}></a>
          <span class="djv-v" aria-hidden="true">{d.show}</span>
          <span class="djv-b">
            <span class="djv-k">{d.days}{d.time && <i>{d.time}</i>}</span>
            <b class="djv-n">{d.show}</b>
            <span class="djv-w">{d.name !== d.show ? d.name : 'DJ invité'}</span>
            <span class="djv-go">Voir le set<I n="right" s={15} /></span>
          </span>
        </article>
      ))}
    </div>
  </section>
</Base>
