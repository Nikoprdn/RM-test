---
// Les univers (volets photo plein cadre) — accueil et page « Nos radios ».
// The Sound of Monte-Carlo réunit les départs Monte-Carlo et Paris, avec sa playlist.
import I from './Icons.astro';
import { u, asset } from '../lib/url.js';
import { UNIVERS } from '../lib/stations.js';
const { eyebrow = '01 — Nos webradios', h1 = false, id = 'radios' } = Astro.props;
const H = h1 ? 'h1' : 'h2';
const bandsLabel = (bands) => bands.map((b) => (b.city ? b.city + ' ' : '') + b.f).join(', ');
---
  <section id={id} data-full data-reveal class="uvs">
    <div class="uvrow">
      {UNIVERS.map((r, g) => (
        <article class:list={['ux', { dk: r.ink === '#141218', 'ux-g': r.departs }]} data-ux={r.ids[0]} data-ux-st={r.ids.join(',')} style={`--c:${r.color};--w:${r.wash};--d:${(g * 0.09 + 0.12).toFixed(2)}s`}>
          <img class="uxp" src={asset(r.photo)} alt="" loading="lazy" style={`object-position:${r.pos}`} />
          <span class="uxt0" aria-hidden="true"></span><span class="uxs" aria-hidden="true"></span><span class="uxw" aria-hidden="true"></span><span class="uxbar" aria-hidden="true"></span>
          <button class="ux-hit" type="button" data-rm-live={r.ids[0]} aria-label={`Écouter ${r.departs ? r.name + ', départ Monte-Carlo' : 'Radio Monaco ' + r.name}`}></button>
          <span class="uxb rise">
            <span class="uxh"><img class="uxl" src={asset(r.logo)} alt={r.departs ? r.name : `Radio Monaco ${r.name}`} width="128" height="46" /><span class="uxpl" aria-hidden="true"><I n="pp" /></span></span>
            <span class="uxr" aria-hidden="true"></span>
            <span class="uxlv"><span class="live-dot"></span><span data-ux-status>En direct</span></span>
            {r.departs ? (
              <span class="uxf uxd" aria-label="Deux départs">
                {r.departs.map((d) => (
                  <button class="uxdp" type="button" data-rm-live={d.i} data-ux-dep={d.i} aria-label={`Écouter ${r.name}, départ ${d.name}`}>
                    <span class="uxdn"><span class="uxdi"><I n="pp" /></span>{d.name}</span>
                    <span class="uxdb">{d.bands.map((b) => <span class="bd">{b.city}<b>{b.f}</b></span>)}{d.note && <span class="uxdnote">{d.note}</span>}</span>
                  </button>
                ))}
              </span>
            ) : (
              <span class="uxf" aria-label={'Diffusion : ' + bandsLabel(r.bands)}>{r.bands.map((b) => <span class="bd">{b.city}<b>{b.f}</b></span>)}</span>
            )}
            <span class="uxi"><span><span class="uxn">
              <span class="uxc"><img data-ux-cover alt="Pochette du titre en cours" hidden /><I n="eq" /></span>
              <span class="uxt"><span class="uxt1" data-ux-t1>{r.line}</span><span class="uxt2" data-ux-t2>En direct</span></span>
            </span></span></span>
            {r.playlist && (
              <span class="uxq" data-ux-pl={r.ids[0]} hidden>
                <span class="uxqh">Déjà passés</span>
                <span class="uxql" data-ux-pll></span>
                <a class="uxqa" href={u('/playlist/')}>Toute la playlist<I n="right" s={14} /></a>
              </span>
            )}
          </span>
        </article>
      ))}
    </div>
    <div class="uvtop" aria-hidden="true"></div>
    <div class="uvtitle">
      <p class="eb uveb" style="margin:0 0 18px;font-size:12px;font-weight:500;letter-spacing:.24em;text-transform:uppercase">{eyebrow}</p>
      <H class="uvh"><span class="m"><span>Découvrez</span></span> <span class="m"><span style="font-weight:600">nos univers.</span></span></H>
    </div>
  </section>
