---
// Les univers en volets (accordéon photo) : un volet ouvert en grand, les autres réduits.
// Accueil et page « Nos radios ». Les crochets data-ux* sont alimentés par scripts/home.js.
import I from './Icons.astro';
import { u, asset } from '../lib/url.js';
import { UNIVERS } from '../lib/stations.js';
const { eyebrow = 'Nos webradios', h1 = false, id = 'radios' } = Astro.props;
const H = h1 ? 'h1' : 'h2';
const accroche = (s) => { const i = s.lastIndexOf(' '); return [s.slice(0, i + 1), s.slice(i + 1)]; };
const court = (bands) => [...new Set(bands.map((b) => (b.f === 'Web' ? 'Web' : /FM/.test(b.f) ? 'FM' : b.f)))].join(' · ');
---
  <section id={id} data-full data-reveal data-snap class="vbs">
    <div class="vbhd">
      <p class="eb vbeb">{eyebrow}</p>
      <H class="vbh"><span class="m"><span>Découvrez</span></span> <span class="m"><span><b>nos univers.</b></span></span></H>
    </div>
    <div class="vbrow" data-vb>
      {UNIVERS.map((r, g) => {
        const nm = r.departs ? r.name : 'Radio Monaco ' + r.name;
        const [a, b] = accroche(r.line);
        return (
          <article class:list={['vb', { op: g === 0, dk: r.ink === '#141218' }]} data-ux={r.ids[0]} data-ux-st={r.ids.join(',')} style={`--c:${r.color};--d:${(g * 0.08 + 0.1).toFixed(2)}s`}>
            <img class="vbp" src={asset(r.photo)} alt="" loading={g ? 'lazy' : 'eager'} style={`object-position:${r.pos}`} />
            <span class="vbsh" aria-hidden="true"></span>
            <button class="vbtg" type="button" aria-expanded={g === 0 ? 'true' : 'false'} aria-controls={'vb-' + r.key} aria-label={'Afficher ' + nm}></button>
            <span class="vbv" aria-hidden="true">{r.name}<i>{court(r.bands)}</i></span>
            <div class="vbc">
              <img class="vbl" src={asset(r.logo)} alt={nm} width="128" height="46" />
              <div class="vbo" id={'vb-' + r.key}><div class="vbi">
                <p class="vba">{a}<b>{b}.</b></p>
                <div class="vbg">
                  <div class="vbm">
                    <p class="vblv"><span class="live-dot"></span><span data-ux-status>En direct</span></p>
                    <p class="vbn"><span class="vbcv"><img data-ux-cover alt="" hidden /></span><span><b data-ux-t1>{r.line}</b><i data-ux-t2>En direct</i></span></p>
                    <ul class="vbf">{r.bands.map((x) => <li>{x.city && <span>{x.city}</span>}<b>{x.f === 'Web' ? 'Site & appli' : x.f}</b></li>)}</ul>
                    <button class="vbgo" type="button" data-rm-live={r.ids[0]}><span class="vbpi"><I n="pp" /></span>Écouter {r.name}</button>
                  </div>
                  {r.playlist !== null && (
                    <span class="uxq vbq" data-ux-pl={r.playlist} data-mark={asset('rm-mark.png')} hidden>
                      <span class="uxqh">Déjà passés</span>
                      <span class="uxql" data-ux-pll></span>
                      <a class="uxqa" href={u('/playlist/')}>Toute la playlist<I n="right" s={14} /></a>
                    </span>
                  )}
                </div>
              </div></div>
              <button class="vbpl" type="button" data-rm-live={r.ids[0]} aria-label={'Écouter ' + nm}><I n="pp" /></button>
            </div>
          </article>
        );
      })}
    </div>
  </section>

<script>
  // un seul volet ouvert : survol (souris), toucher ou clavier ; le dernier ouvert reste ouvert
  const init = () => document.querySelectorAll('[data-vb]').forEach((row) => {
    if (row.dataset.ok) return; row.dataset.ok = '1';
    const items = [...row.children]; const fine = matchMedia('(hover: hover) and (min-width: 901px)'); let t = 0;
    const open = (el) => items.forEach((x) => { const o = x === el; x.classList.toggle('op', o); x.querySelector('.vbtg').setAttribute('aria-expanded', o ? 'true' : 'false'); });
    items.forEach((x) => {
      x.addEventListener('mouseenter', () => { if (!fine.matches) return; clearTimeout(t); t = setTimeout(() => open(x), 90); });
      x.addEventListener('mouseleave', () => clearTimeout(t));
      x.querySelector('.vbtg').addEventListener('click', () => open(x));
      x.querySelector('.vbpl').addEventListener('click', () => open(x));
    });
  });
  document.addEventListener('astro:page-load', init); init();
</script>
