---
// Lecteur global : il reste en place quand on change de page (transition:persist),
// donc le son ne se coupe jamais pendant la navigation.
import { STATIONS } from '../lib/stations.js';
import { asset, u } from '../lib/url.js';
import { getToday, WP } from '../lib/data.js';
const today = await getToday().catch(() => []);
const cfg = {
  wp: WP,
  stations: STATIONS.map((s) => ({ key: s.key, name: s.name, color: s.color, ink: s.ink, stream: s.stream, line: s.line, art: asset(s.logoInk), photo: asset(s.photo) })),
  today,
  icon: asset('icon-512.png')
};
---
<div class="dock" id="dock" role="region" aria-label="Lecteur" transition:persist="player" transition:name="player">
  <audio id="rm-audio" preload="none" x-webkit-airplay="allow"></audio>
  <!-- styles du bandeau « à l'antenne » : ils voyagent avec le lecteur (persistant), même si une page en cache a une feuille plus ancienne -->
  <style is:inline>
.dock{transition:border-radius .5s cubic-bezier(.16,.84,.12,1)}
.doa{position:absolute;left:0;right:0;bottom:calc(100% - 1px);display:flex;align-items:stretch;background:#fff;border-radius:26px 26px 0 0;border-bottom:1px solid rgba(20,18,24,.08);box-shadow:0 0 0 1px rgba(20,18,24,.06),0 -22px 44px -26px rgba(20,18,24,.4);clip-path:inset(-60px -60px 0 -60px);overflow:visible;opacity:0;visibility:hidden;transform:translateY(16px);transform-origin:bottom center;pointer-events:none;transition:opacity .35s ease,transform .5s cubic-bezier(.16,.84,.12,1),visibility 0s linear .5s}
.dock.home{border-radius:0 0 30px 30px}
.dock.home .doa{opacity:1;visibility:visible;transform:none;pointer-events:auto;transition:opacity .45s ease .1s,transform .6s cubic-bezier(.16,.84,.12,1) .05s,visibility 0s}
.doa-now{flex:1 1 auto;min-width:0;display:flex;align-items:center;gap:14px;padding:12px 18px 12px 12px;border:0;background:none;color:var(--ink);font:inherit;text-align:left;cursor:pointer;border-radius:26px 0 0 0}
.doa-img{flex:none;width:52px;height:52px;border-radius:14px;overflow:hidden;background:#E4032E}
.doa-img img{width:100%;height:100%;object-fit:cover;display:block}
.doa-t{min-width:0;flex:1;display:flex;flex-direction:column;gap:4px}
.doa-k{display:flex;align-items:center;gap:8px;font-size:10.5px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);white-space:nowrap}
.doa .live-dot{background:#E4032E}
.doa-h{letter-spacing:.04em;font-weight:500}
.doa-h:not(:empty)::before{content:"·";margin:0 7px 0 1px}
.doa-n{font-size:16px;font-weight:600;letter-spacing:-.01em;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.doa-p{display:block;height:3px;border-radius:3px;background:rgba(20,18,24,.1);overflow:hidden;margin-top:3px}
.doa-p i{display:block;height:100%;width:0;background:#E4032E;border-radius:3px;transition:width 1s ease}
.doa-next{flex:0 0 34%;min-width:0;display:flex;flex-direction:column;justify-content:center;gap:5px;padding:12px 20px 12px 18px;border-left:1px solid rgba(20,18,24,.08);color:var(--ink);text-decoration:none;border-radius:0 26px 0 0}
.doa-now:hover,.doa-next:hover{background:rgba(20,18,24,.035)}
.doa-n2{font-size:14px;font-weight:500;line-height:1.2;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
@media (max-width:640px){
  .doa{flex-direction:column;border-radius:22px 22px 0 0}
  .dock.home{border-radius:0 0 28px 28px}
  .doa-now{padding:10px 14px 8px 10px;border-radius:22px 22px 0 0;gap:12px}
  .doa-img{width:44px;height:44px;border-radius:12px}
  .doa-n{font-size:15px}
  .doa-next{flex:none;flex-direction:row;align-items:center;justify-content:space-between;gap:12px;padding:6px 16px 10px;border-left:0;border-radius:0}
  .doa-n2{font-size:13px;-webkit-line-clamp:1;text-align:right}
}
/* le nom de transition (qui garde le lecteur immobile entre deux pages) n'est posé que pendant la transition :
   sinon Chrome isole le lecteur et le flou du verre ne voit plus la page derrière */
#dock{view-transition-name:none}
html[data-astro-transition] #dock{view-transition-name:player}
/* bulle de verre (façon Apple) pour la partie « à l'antenne » ; le lecteur dessous reste opaque */
.doa{background:linear-gradient(180deg,rgba(255,255,255,.62),rgba(255,255,255,.46));-webkit-backdrop-filter:blur(30px) saturate(1.9);backdrop-filter:blur(30px) saturate(1.9);border:1px solid rgba(255,255,255,.6);border-bottom:0;box-shadow:inset 0 1px 0 rgba(255,255,255,.85),inset 0 -1px 0 rgba(255,255,255,.25),0 -24px 48px -28px rgba(10,10,20,.45)}
.doa-k{color:rgba(20,18,24,.62)}
.doa-p{background:rgba(20,18,24,.14)}
.doa-next{border-left-color:rgba(20,18,24,.1)}
.doa-now:hover,.doa-next:hover{background:rgba(255,255,255,.28)}
.dock.home{box-shadow:0 0 0 1px rgba(20,18,24,.06),0 10px 24px -8px rgba(20,18,24,.22),0 34px 70px -24px rgba(20,18,24,.42)}
/* page Radios : le lecteur entier en verre dépoli */
.dock.glass{background:linear-gradient(180deg,rgba(255,255,255,.66),rgba(255,255,255,.5));-webkit-backdrop-filter:blur(30px) saturate(1.9) brightness(1.12);backdrop-filter:blur(30px) saturate(1.9) brightness(1.12);box-shadow:inset 0 1px 0 rgba(255,255,255,.85),inset 0 0 0 1px rgba(255,255,255,.5),0 10px 24px -8px rgba(10,10,20,.25),0 34px 70px -24px rgba(10,10,20,.5)}
.dock.glass .dk,.dock.glass .dt i{color:rgba(20,18,24,.66)}
.dock.glass .dsm{border-color:rgba(20,18,24,.18)}
  </style>
  <!-- émission à l'antenne : rattachée au lecteur, visible seulement sur l'accueil -->
  <div class="doa" id="dock-oa">
    <button class="doa-now" type="button" data-rm-live="0" aria-label="Écouter le direct">
      <span class="doa-img"><img id="doa-img" src={asset('rm-mark.png')} alt="" width="48" height="48" /></span>
      <span class="doa-t">
        <span class="doa-k"><span class="live-dot"></span>En ce moment<span class="doa-h" id="doa-time"></span></span>
        <span class="doa-n" id="doa-now">The sound of Monte-Carlo</span>
        <span class="doa-p" aria-hidden="true"><i id="doa-prog"></i></span>
      </span>
    </button>
    <a class="doa-next" href={u('/programmes/')}>
      <span class="doa-k">À suivre<span class="doa-h" id="doa-nt"></span></span>
      <span class="doa-n2" id="doa-next">Le programme du jour</span>
    </a>
  </div>
  <span class="dcv" aria-hidden="true"><img id="dock-cover" alt="" hidden /><span class="eq" style="color:#fff"><i></i><i></i><i></i><i></i></span></span>
  <span class="dtx">
    <span class="dk"><span class="live-dot"></span><span id="dock-kind">Direct · Monte-Carlo</span></span>
    <span class="dt" id="dock-title"><b>The sound of Monte-Carlo</b><i> · En direct</i></span>
  </span>
  <span class="eq hide-sm" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
  <button class="dsm cast" id="dock-cast" type="button" aria-label="Écouter sur un autre appareil (AirPlay, Chromecast)" hidden>
    <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 17H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-1"/><path d="m12 15 5 6H7z"/></svg>
  </button>
  <button class="dsm" id="dock-live" type="button" aria-label="Revenir au direct" hidden>
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="2.5" fill="currentColor"/><path d="M7.8 7.8a6 6 0 0 0 0 8.4M16.2 7.8a6 6 0 0 1 0 8.4M5 5a10 10 0 0 0 0 14M19 5a10 10 0 0 1 0 14"/></svg>
  </button>
  <button class="dbtn" id="dock-play" type="button" aria-label="Écouter le direct">
    <svg class="ic-play" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
    <svg class="ic-pause" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor"/></svg>
  </button>
  <span class="dprog" id="dock-prog" aria-hidden="true"><i style="width:0%"></i></span>
  <script type="application/json" id="rm-config" set:html={JSON.stringify(cfg).replace(/</g, '\\u003c')}></script>
</div>
<script src="../scripts/player.js"></script>
