---
// Lecteur global : il reste en place quand on change de page (transition:persist),
// donc le son ne se coupe jamais pendant la navigation.
import { STATIONS } from '../lib/stations.js';
import { asset, u } from '../lib/url.js';
import { getToday, WP, getPodcasts, ausImg, ausAudio } from '../lib/data.js';
const today = await getToday().catch(() => []);
// la file du studio : les derniers épisodes publiés, toutes émissions confondues
const pods = (await getPodcasts().catch(() => []))
  .flatMap((sh) => sh.eps.slice(0, 4).map((e, i) => ({ id: sh.k + ':' + i, d: e.d, url: ausAudio(e.au), title: e.title, show: sh.name, color: sh.color, ink: sh.feed === 'mixdj' ? '#141218' : '#FFFFFF', img: ausImg(e.img), s: e.s })))
  .sort((x, y) => (x.d < y.d ? 1 : -1))
  .slice(0, 30);
const cfg = {
  wp: WP,
  stations: STATIONS.map((s) => ({ key: s.key, name: s.name, color: s.color, ink: s.ink, stream: s.stream, line: s.line, art: asset(s.logoInk), photo: asset(s.photo), fb: asset(s.cover) })),
  today,
  pods,
  studio: asset('rm-studio.jpg'),
  icon: asset('icon-512.png')
};
---
<div class="dock" id="dock" role="region" aria-label="Lecteur" transition:persist="player" transition:name="player">
  <audio id="rm-audio" preload="none" x-webkit-airplay="allow"></audio>
  <!-- styles du lecteur (verre calme) : ils voyagent avec le lecteur persistant, même si une page en cache a une feuille plus ancienne -->
  <style is:inline>
/* le nom de transition n'est posé que pendant les changements de page : sinon Chrome isole le lecteur et le flou ne voit plus la page */
#dock{view-transition-name:none}
html[data-astro-transition] #dock{view-transition-name:player}
/* verre calme : capsule en verre dépoli clair, sans reflet ; texte foncé lisible partout ; rouge réservé au point « en direct » */
#dock{width:min(560px,calc(100% - 24px));height:54px;padding:0 7px;gap:12px;border:0;border-radius:999px;background:rgba(255,255,255,.62);-webkit-backdrop-filter:blur(22px) saturate(1.4);backdrop-filter:blur(22px) saturate(1.4);box-shadow:inset 0 0 0 1px rgba(255,255,255,.45),0 0 0 1px rgba(20,18,24,.05),0 12px 30px -14px rgba(0,0,0,.35)}
#dock .dcv{width:40px;height:40px;border-radius:50%;background:rgba(20,18,24,.08)}
/* vu-mètre posé sur la pochette, légèrement voilée pour qu'il se lise */
#dock .dcv .eq{position:relative;z-index:1;color:#141218}
#dock .dcv:has(img:not([hidden])) .eq{color:#fff}
#dock .dcv:has(img:not([hidden]))::after{content:"";position:absolute;inset:0;background:rgba(10,10,16,.32);border-radius:inherit}
#dock .dcv img{filter:saturate(.95)}
#dock .dcv .eq{display:flex!important}
#dock .dbtn,#dock .dbtn.ink{width:40px;height:40px;background:#141218;color:#fff}
#dock .dk{color:rgba(20,18,24,.55);transition:opacity .3s ease}
#dock .dk .live-dot{background:#E4032E}
#dock .dt{font-size:14px;color:#141218}
#dock .dt i{color:rgba(20,18,24,.6)}
#dock > .eq{color:rgba(20,18,24,.38)}
#dock .dsm{border-color:rgba(20,18,24,.14)}
  </style>
  <span class="dcv" aria-hidden="true"><img id="dock-cover" alt="" hidden /><span class="eq"><i></i><i></i><i></i><i></i></span></span>
  <button class="dtx" id="dock-open" type="button" aria-label="Ouvrir le studio" aria-expanded="false">
    <span class="dk"><span class="live-dot"></span><span id="dock-kind">Direct · Monte-Carlo</span></span>
    <span class="dt" id="dock-title"><b>The sound of Monte-Carlo</b><i> · En direct</i></span>
  </button>
  <span class="eq hide-sm" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
  <button class="dsm cast" id="dock-cast" type="button" aria-label="Écouter sur un autre appareil (AirPlay, Chromecast)" hidden>
    <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 17H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-1"/><path d="m12 15 5 6H7z"/></svg>
  </button>
  <button class="dsm" id="dock-live" type="button" aria-label="Revenir au direct" hidden>
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="2.5" fill="currentColor"/><path d="M7.8 7.8a6 6 0 0 0 0 8.4M16.2 7.8a6 6 0 0 1 0 8.4M5 5a10 10 0 0 0 0 14M19 5a10 10 0 0 1 0 14"/></svg>
  </button>
  <button class="dbtn" id="dock-play" type="button" aria-label="Écouter le direct">
    <svg class="ic-play" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
    <svg class="ic-pause" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor"/></svg>
  </button>
  <span class="dprog" id="dock-prog" aria-hidden="true"><i style="width:0%"></i></span>
  <script type="application/json" id="rm-config" set:html={JSON.stringify(cfg).replace(/</g, '\\u003c')}></script>
</div>

  <!-- Le studio : le lecteur en grand, dans le décor de la régie -->
<div class="stu" id="stu" transition:persist="studio" role="dialog" aria-modal="true" aria-label="Le studio" hidden>
    <img class="stu-bg" src={asset('rm-studio.jpg')} alt="" />
    <span class="stu-sc" aria-hidden="true"></span>
    <button class="stu-x" id="stu-close" type="button" aria-label="Fermer le studio">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    <div class="stu-w">
      <div class="stu-l">
        <span class="stu-cv"><img id="stu-cover" alt="" hidden /><span class="eq" id="stu-eq"><i></i><i></i><i></i><i></i></span></span>
        <p class="stu-k"><span class="live-dot"></span><span id="stu-kind">Direct · Monte-Carlo</span></p>
        <p class="stu-t" id="stu-title">The sound of Monte-Carlo</p>
        <p class="stu-s" id="stu-sub">En direct</p>
        <div class="stu-bar" id="stu-bar"><i></i><b></b></div>
        <div class="stu-tt"><span id="stu-t0">0:00</span><span id="stu-t1">En direct</span></div>
        <div class="stu-c">
          <button class="stu-b" id="stu-back" type="button" aria-label="Reculer de 15 secondes"><span>15</span></button>
          <button class="stu-big" id="stu-play" type="button" aria-label="Lecture ou pause">
            <svg class="ic-play" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
            <svg class="ic-pause" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor"/></svg>
          </button>
          <button class="stu-b" id="stu-fwd" type="button" aria-label="Avancer de 30 secondes"><span>30</span></button>
          <button class="stu-sh" id="stu-shuffle" type="button" aria-pressed="false" aria-label="Lecture aléatoire">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3h5v5"/><path d="M4 20 21 3"/><path d="M21 16v5h-5"/><path d="m15 15 6 6"/><path d="M4 4l5 5"/></svg>
            Aléatoire
          </button>
        </div>
      </div>
      <div class="stu-r">
        <div class="stu-tabs" role="tablist">
          <button class="stu-tb on" type="button" role="tab" data-stu-tab="pods" aria-selected="true">Derniers publiés</button>
          <button class="stu-tb" type="button" role="tab" data-stu-tab="live" aria-selected="false">Nos radios</button>
        </div>
        <div class="stu-list" id="stu-list"></div>
      </div>
    </div>
  </div>
<script src="../scripts/player.js"></script>
