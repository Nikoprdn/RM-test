---
import { u } from '../lib/url.js';
import { dateShort } from '../lib/data.js';
const { p, wide = false, eager = false } = Astro.props;
---
<a href={u(p.path)} class:list={['card', { wide }]}>
  <span class="im">{p.cat && <span class="tag">{p.cat}</span>}{p.img && <img src={wide ? p.img.large : p.img.medium} srcset={p.img.srcset || undefined} sizes={wide ? '(max-width: 860px) 100vw, 50vw' : '(max-width: 700px) 100vw, 33vw'} alt={p.img.alt || ''} loading={eager ? 'eager' : 'lazy'} />}</span>
  <span style="display:flex;flex-direction:column;gap:10px">
    <span class="k"><span class="kc">{p.cat} · </span><i>{dateShort(p.date)}</i></span>
    <span class="t">{p.title}</span>
    {wide && p.excerpt && <span class="e">{p.excerpt}</span>}
  </span>
</a>
