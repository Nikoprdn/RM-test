---
// Rubrique podcasts : bandeau photo et recherche, les derniers épisodes qui
// défilent seuls, puis des rails par univers — accueil et page « Podcasts ».
import I from './Icons.astro';
import { u, asset } from '../lib/url.js';
import { getPodcasts, ausImg, ausAudio, dur, dateShort, FEED_LABEL } from '../lib/data.js';
const { eyebrow = 'Podcasts', h1 = false, more = true } = Astro.props;
const H = h1 ? 'h1' : 'h2';
const pods = await getPodcasts();
const all = pods.flatMap((s) => s.eps.slice(0, 7).map((e, i) => ({ s, e, i }))).sort((a, b) => (a.e.d < b.e.d ? 1 : -1));
const epJSON = (x) => JSON.stringify({ id: x.s.k + ':' + x.i, url: ausAudio(x.e.au), title: x.e.title, show: x.s.name, color: x.s.color, ink: x.s.feed === 'mixdj' ? '#141218' : '#FFFFFF', img: ausImg(x.e.img), s: x.e.s });
const when = (iso) => { const d = new Date(iso + 'Z'), t = new Date(); const diff = Math.round((new Date(t.getFullYear(), t.getMonth(), t.getDate()) - new Date(d.getFullYear(), d.getMonth(), d.getDate())) / 864e5); return diff <= 0 ? 'Aujourd’hui' : diff === 1 ? 'Hier' : diff < 7 ? `Il y a ${diff} jours` : dateShort(iso); };
// « depuis quand publié », toujours relatif : aujourd'hui, hier, il y a 3 jours, 2 semaines, 2 mois
const depuis = (iso) => { const d = new Date(iso + 'Z'), t = new Date(); const j = Math.round((new Date(t.getFullYear(), t.getMonth(), t.getDate()) - new Date(d.getFullYear(), d.getMonth(), d.getDate())) / 864e5); if (j <= 0) return 'Aujourd’hui'; if (j === 1) return 'Hier'; if (j < 14) return `Il y a ${j} jours`; if (j < 60) return `Il y a ${Math.round(j / 7)} semaines`; const m = Math.round(j / 30.4); return m < 12 ? `Il y a ${m} mois` : (m < 24 ? 'Il y a 1 an' : `Il y a ${Math.round(m / 12)} ans`); };
const clean = (x) => String(x).toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
// Deux rails qui défilent seuls : les derniers épisodes (émissions, horoscope) et
// les derniers mixs, puis les émissions par univers.
// « Podcasts à la une » retiré à la demande de Nicolas (16 novembre 2026).
const eps = all.filter((x) => x.s.feed !== 'mixdj');
const mixs = all.filter((x) => x.s.feed === 'mixdj');
const duo = [
  ['Les derniers épisodes', eps.slice(0, 20), eps.length, 'à réécouter'],
  ['Les derniers mixs', mixs.slice(0, 20), mixs.length, 'mixs']
].filter(([, l]) => l.length);
// candidats du volet « les podcasts du jour » : les 16 épisodes les plus récents
const jour = all.slice(0, 16);
// surtitre des cartes d'émissions, même présentation que les cartes d'épisodes :
// « Mix DJ » (orange), « Chronique » pour les chroniques du Morning, « L’intégrale » pour
// Le Morning lui-même (le replay intégral de l’émission), « Horoscope » pour Les Étoilés.
const genre = (s) => (s.feed === 'mixdj' ? 'Mix DJ' : s.feed === 'horoscope' ? 'Horoscope' : s.k === 'morning' ? 'L’intégrale' : 'Chronique');
const univers = [
  ['Le Morning & les chroniques', pods.filter((s) => s.feed === 'emissions' || s.feed === 'horoscope')],
  [FEED_LABEL.mixdj, pods.filter((s) => s.feed === 'mixdj')]
].filter(([, l]) => l.length);
---
<section id="podcasts" data-full data-reveal data-snap class:list={['pzs', { 'pod-s-h': h1 }]}>

  <div class="pod-b">
      <img class="pod-b-im" src={asset('rm-studio.jpg')} alt="Le studio de Radio Monaco" fetchpriority="high" />
      <span class="pod-b-sc" aria-hidden="true"></span>
      <div class="pod-b-in">
        <H class="pod-b-h"><span class="m"><span>Écoutez vos</span></span>{' '}<span class="m"><span style="font-weight:600">podcasts préférés.</span></span></H>
        <form class="pod-q" role="search" onsubmit="return false">
          <label class="vh" for="pz-q">Rechercher une émission ou un épisode</label>
          <input id="pz-q" type="search" autocomplete="off" placeholder="Rechercher une émission, un épisode…" />
          <span class="pod-q-b" aria-hidden="true"><I n="search" s={18} /></span>
        </form>
        <p class="pod-q-r" data-pz-count hidden></p>
        {h1 && (
          /* Pastille « les podcasts du jour » (page Podcasts, choix N1 du 17/11/2026) : une
             ligne sous la recherche ; au clic, la liste des épisodes du jour se déroule.
             Le tri par jour se fait dans le navigateur (le site est construit à l'avance) :
             les épisodes d'aujourd'hui, sinon ceux du dernier jour publié. */
          <div class="pod-n" data-pod-j hidden>
            <button class="pod-n-b" type="button" aria-expanded="false" aria-controls="pod-n-l">
              <span class="pod-n-av" data-pod-j-av aria-hidden="true"></span>
              <span class="pod-n-dot" aria-hidden="true"></span>
              <span class="pod-n-t" data-pod-j-n></span>
              <span class="pod-n-c" aria-hidden="true"><I n="right" s={14} /></span>
            </button>
            <ul class="pod-n-l" id="pod-n-l" hidden>
              {jour.map((x) => (
                <li data-pod-j-d={x.e.d} hidden>
                  <button type="button" data-rm-ep={epJSON(x)} data-epid={x.s.k + ':' + x.i} aria-label={`Écouter : ${x.s.name}, ${x.e.title}`}>
                    <img src={ausImg(x.e.img)} alt="" loading="lazy" />
                    <span class="pod-n-e">
                      <em style={`--c:${x.s.color}`}>{x.s.name}</em>
                      <span>{x.e.title}</span>
                    </span>
                    <span class="pod-n-p" aria-hidden="true"><I n="play" s={13} /></span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        )}
        {!h1 && more && <a class="pod-b-all" href={u('/podcasts/')}>Tous les podcasts<I n="right" s={18} /></a>}
      </div>
    </div>

  <div class="pod-w">

    {/* Deux rails côte à côte qui défilent seuls : les derniers épisodes à gauche,
        les derniers mixs à droite (demande de Nicolas, 16 novembre 2026). */}
    <div class="pod-duo">
      {duo.map(([titre, liste, total, unite]) => (
        <div class="pod-r" data-pz-sec>
          <div class="pod-r-h"><h3>{titre}</h3><i aria-hidden="true">›</i><em>{total} {unite}</em></div>
          <div class="pod-r-w">
            <button class="pod-r-n l" type="button" data-rail="-1" aria-label="Précédents"><I n="left" s={16} /></button>
            <div class="pod-r-r pod-r-auto" data-rail-row data-rail-auto>
              {liste.map((x) => (
                <article class="pod-t pod-t-ep" data-pz-i={clean(titre + ' ' + x.s.name + ' ' + x.e.title + ' ' + x.s.sub)}>
                  <button class="pod-t-v" type="button" data-rm-ep={epJSON(x)} data-epid={x.s.k + ':' + x.i} aria-label={`Écouter : ${x.s.name}, ${x.e.title}`}>
                    <img src={ausImg(x.e.img)} alt="" loading="lazy" />
                    <span class="pod-t-p" aria-hidden="true"><I n="play" s={15} /></span>
                  </button>
                  <em class="pod-t-f" style={`--c:${x.s.color}`}>{x.s.name}</em>
                  <b>{x.e.title}</b>
                  <small>{depuis(x.e.d)}</small>
                </article>
              ))}
            </div>
            <button class="pod-r-n r" type="button" data-rail="1" aria-label="Suivants"><I n="right" s={16} /></button>
          </div>
        </div>
      ))}
    </div>

    {univers.map(([label, list]) => (
      <div class="pod-r" data-pz-sec>
        <div class="pod-r-h"><h3>{label}</h3><i aria-hidden="true">›</i><em>{list.length} {list[0].feed === 'mixdj' ? 'émissions' : 'chroniques'}</em></div>
        <div class="pod-r-w">
          <button class="pod-r-n l" type="button" data-rail="-1" aria-label="Précédentes"><I n="left" s={16} /></button>
          <div class="pod-r-r" data-rail-row>
            {list.map((s) => (
              <article class="pod-t pod-t-ep" data-pz-i={clean(label + ' ' + s.name + ' ' + s.sub + ' ' + s.eps[0].title)}>
                <a class="pod-t-v" href={u('/podcasts/' + s.k + '/')} aria-label={s.name}>
                  <img src={ausImg(s.eps[0].img)} alt="" loading="lazy" />
                  <span class="pod-t-p" aria-hidden="true"><I n="right" s={15} /></span>
                </a>
                <em class="pod-t-f" style={`--c:${s.color}`}>{genre(s)}</em>
                <b>{s.name}</b>
                <small>{s.feed === 'mixdj' ? s.sub.replace(/^by\s+/i, '') : s.sub}</small>
              </article>
            ))}
          </div>
          <button class="pod-r-n r" type="button" data-rail="1" aria-label="Suivantes"><I n="right" s={16} /></button>
        </div>
      </div>
    ))}

    <p class="pod-q-none" data-pz-none hidden>Aucune émission ne correspond à votre recherche.</p>
  </div>
</section>

<script>
  // Pastille « les podcasts du jour » (page Podcasts) : les épisodes publiés aujourd'hui,
  // sinon ceux du dernier jour publié. La pastille annonce leur nombre ; un clic déroule
  // la liste de tous ces épisodes, posée par-dessus la page. Échap ou un clic ailleurs la referme.
  function initJour() {
    const box = document.querySelector('[data-pod-j]'); if (!box || box.dataset.ok) return; box.dataset.ok = '1';
    const day = (d) => d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate();
    const today = day(new Date());
    const rows = [...box.querySelectorAll('[data-pod-j-d]')].map((li) => ({ li, k: day(new Date(li.dataset.podJD + 'Z')) }));
    if (!rows.length) return;
    let pick = rows.filter((r) => r.k === today), quand = 'aujourd’hui';
    if (!pick.length) {
      const last = rows[0].k; pick = rows.filter((r) => r.k === last);
      const y = new Date(); y.setDate(y.getDate() - 1);
      quand = last === day(y) ? 'hier' : 'récemment';
    }
    const n = pick.length;
    pick.forEach((r) => { r.li.hidden = false; r.li.querySelector('img').loading = 'eager'; });
    box.querySelector('[data-pod-j-n]').innerHTML = (n > 1 ? `<b>${n} nouveaux podcasts</b> ajoutés ` : '<b>1 nouveau podcast</b> ajouté ') + quand;
    const av = box.querySelector('[data-pod-j-av]');
    pick.slice(0, 3).forEach((r) => { const i = document.createElement('img'); i.src = r.li.querySelector('img').getAttribute('src'); i.alt = ''; av.appendChild(i); });
    const btn = box.querySelector('.pod-n-b'), list = box.querySelector('.pod-n-l');
    const fit = () => { const top = btn.getBoundingClientRect().bottom + 10; list.style.maxHeight = Math.max(170, innerHeight - top - 104) + 'px'; }; // place jusqu'à la capsule du lecteur
    const set = (open) => { btn.setAttribute('aria-expanded', String(open)); box.classList.toggle('open', open); if (open) { fit(); list.hidden = false; } else setTimeout(() => { if (!box.classList.contains('open')) list.hidden = true; }, 380); };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    const ctl = new AbortController();
    document.addEventListener('click', (e) => { if (!box.contains(e.target) && box.classList.contains('open')) set(false); }, { signal: ctl.signal });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && box.classList.contains('open')) { set(false); btn.focus(); } }, { signal: ctl.signal });
    document.addEventListener('astro:before-swap', () => ctl.abort(), { once: true });
    box.hidden = false;
    requestAnimationFrame(() => box.classList.add('in'));
  }
  document.addEventListener('astro:page-load', initJour); initJour();
</script>
