---
// Rubrique podcasts : bandeau photo et recherche, les podcasts à la une,
// puis des rails par univers — accueil et page « Podcasts ».
import I from './Icons.astro';
import { u, asset } from '../lib/url.js';
import { getPodcasts, ausImg, ausAudio, dur, dateShort, FEED_LABEL } from '../lib/data.js';
const { eyebrow = 'Podcasts', h1 = false, more = true } = Astro.props;
const H = h1 ? 'h1' : 'h2';
const pods = await getPodcasts();
const all = pods.flatMap((s) => s.eps.slice(0, 7).map((e, i) => ({ s, e, i }))).sort((a, b) => (a.e.d < b.e.d ? 1 : -1));
const epJSON = (x) => JSON.stringify({ id: x.s.k + ':' + x.i, url: ausAudio(x.e.au), title: x.e.title, show: x.s.name, color: x.s.color, ink: x.s.feed === 'mixdj' ? '#141218' : '#FFFFFF', img: ausImg(x.e.img), s: x.e.s });
const when = (iso) => { const d = new Date(iso + 'Z'), t = new Date(); const diff = Math.round((new Date(t.getFullYear(), t.getMonth(), t.getDate()) - new Date(d.getFullYear(), d.getMonth(), d.getDate())) / 864e5); return diff <= 0 ? 'Aujourd’hui' : diff === 1 ? 'Hier' : diff < 7 ? `Il y a ${diff} jours` : dateShort(iso); };
const clean = (x) => String(x).toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
// Les deux épisodes à la une, puis les derniers épisodes et les émissions par univers.
const une = all.slice(0, 2);
const derniers = all.slice(0, 10);
const univers = [
  ['Le Morning & les chroniques', pods.filter((s) => s.feed === 'emissions' || s.feed === 'horoscope')],
  [FEED_LABEL.mixdj, pods.filter((s) => s.feed === 'mixdj')]
].filter(([, l]) => l.length);
---
<section id="podcasts" data-reveal class:list={['pzs', { 'pod-s-h': h1 }]}>

  {h1 && (
    <div class="pod-b">
      <img class="pod-b-im" src={asset('rm-studio.jpg')} alt="Le studio de Radio Monaco" fetchpriority="high" />
      <span class="pod-b-sc" aria-hidden="true"></span>
      <div class="pod-b-in">
        <p class="eb pod-b-eb">{eyebrow}</p>
        <h1 class="pod-b-h"><span class="m"><span>Écoutez vos</span></span>{' '}<span class="m"><span style="font-weight:600">podcasts préférés.</span></span></h1>
        <form class="pod-q" role="search" onsubmit="return false">
          <label class="vh" for="pz-q">Rechercher une émission ou un épisode</label>
          <input id="pz-q" type="search" autocomplete="off" placeholder="Rechercher une émission, un épisode…" />
          <span class="pod-q-b" aria-hidden="true"><I n="search" s={18} /></span>
        </form>
        <p class="pod-q-r" data-pz-count hidden></p>
      </div>
    </div>
  )}

  <div class="pod-w">
    {!h1 && (
      <div class="pod-hd">
        <div>
          <p class="eb pod-eb">{eyebrow}</p>
          <H class="pzh"><span class="m"><span>Vos rendez-vous préférés,</span></span>{' '}<span class="m"><span style="font-weight:600">à la demande.</span></span></H>
        </div>
        {more && <a class="pod-more" href={u('/podcasts/')}>Tous les podcasts<I n="right" s={18} /></a>}
      </div>
    )}

    <div class="pod-r" data-pz-sec>
      <div class="pod-r-h"><h3>Podcasts à la une</h3><i aria-hidden="true">›</i></div>
      <div class="pod-u">
        {une.map((x) => (
          <article class="pod-c" data-pz-i={clean(x.s.name + ' ' + x.e.title + ' ' + x.s.sub)}>
            <img src={ausImg(x.e.img, true)} alt="" loading="lazy" />
            <span class="pod-c-sc" aria-hidden="true"></span>
            <button class="pod-c-hit" type="button" data-rm-ep={epJSON(x)} data-epid={x.s.k + ':' + x.i} aria-label={`Écouter : ${x.e.title}`}></button>
            <span class="pod-c-t"><b>{x.s.name}</b><span>{x.e.title}</span><em>{when(x.e.d)} · {dur(x.e.s)}</em></span>
            <span class="pod-c-p" aria-hidden="true"><I n="play" s={20} /></span>
          </article>
        ))}
      </div>
    </div>

    <div class="pod-r" data-pz-sec>
      <div class="pod-r-h"><h3>Les derniers épisodes</h3><i aria-hidden="true">›</i><em>{all.length} à réécouter</em></div>
      <div class="pod-r-w">
        <button class="pod-r-n l" type="button" data-rail="-1" aria-label="Précédents"><I n="left" s={16} /></button>
        <div class="pod-r-r" data-rail-row>
          {derniers.map((x) => (
            <article class="pod-t" data-pz-i={clean(x.s.name + ' ' + x.e.title + ' ' + x.s.sub)}>
              <button class="pod-t-v" type="button" data-rm-ep={epJSON(x)} data-epid={x.s.k + ':' + x.i} aria-label={`Écouter : ${x.e.title}`}>
                <img src={ausImg(x.e.img)} alt="" loading="lazy" />
                <span class="pod-t-p" aria-hidden="true"><I n="play" s={15} /></span>
              </button>
              <b>{x.e.title}</b>
              <span>{x.s.name} · {when(x.e.d)}</span>
            </article>
          ))}
        </div>
        <button class="pod-r-n r" type="button" data-rail="1" aria-label="Suivants"><I n="right" s={16} /></button>
      </div>
    </div>

    {univers.map(([label, list]) => (
      <div class="pod-r" data-pz-sec>
        <div class="pod-r-h"><h3>{label}</h3><i aria-hidden="true">›</i><em>{list.length} émissions</em></div>
        <div class="pod-r-w">
          <button class="pod-r-n l" type="button" data-rail="-1" aria-label="Précédentes"><I n="left" s={16} /></button>
          <div class="pod-r-r" data-rail-row>
            {list.map((s) => (
              <article class="pod-t" data-pz-i={clean(label + ' ' + s.name + ' ' + s.sub + ' ' + s.eps[0].title)}>
                <a class="pod-t-v" href={u('/podcasts/' + s.k + '/')} aria-label={s.name}>
                  <img src={ausImg(s.eps[0].img)} alt="" loading="lazy" />
                  <span class="pod-t-p" aria-hidden="true"><I n="right" s={15} /></span>
                </a>
                <b>{s.name}</b>
                <span>{s.sub}</span>
              </article>
            ))}
          </div>
          <button class="pod-r-n r" type="button" data-rail="1" aria-label="Suivantes"><I n="right" s={16} /></button>
        </div>
      </div>
    ))}

    <p class="pod-q-none" data-pz-none hidden>Aucune émission ne correspond à votre recherche.</p>
  </div>
</section>
