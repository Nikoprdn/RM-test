---
// Rubrique podcasts : entête des dernières publications, l'émission du jour ouverte
// séquence par séquence, puis l'arborescence des rendez-vous.
import I from './Icons.astro';
import { u } from '../lib/url.js';
import { getPodcasts, ausImg, ausAudio, dur, dateShort, BRANCHES } from '../lib/data.js';
const { eyebrow = 'Podcasts', h1 = false, more = true } = Astro.props;
const H = h1 ? 'h1' : 'h2';
const pods = await getPodcasts();
const byKey = Object.fromEntries(pods.map((s) => [s.k, s]));
const all = pods.flatMap((s) => s.eps.slice(0, 7).map((e, i) => ({ s, e, i }))).sort((a, b) => (a.e.d < b.e.d ? 1 : -1));
// La journée retenue : la plus récente où la matinale a paru avec ses chroniques.
const jours = {};
pods.filter((s) => s.feed === 'emissions').forEach((s) => s.eps.slice(0, 10).forEach((e, i) => {
  const d = e.d.slice(0, 10); (jours[d] = jours[d] || []).push({ s, e, i });
}));
const dates = Object.keys(jours).sort().reverse();
const jourRef = dates.find((d) => jours[d].length >= 3 && jours[d].some((x) => x.s.k === 'morning')) || dates.find((d) => jours[d].length >= 3) || dates[0] || '';
const duJour = jours[jourRef] || [];
const feat = duJour.find((x) => x.s.k === 'morning') || all.find((x) => x.s.k === 'morning') || all[0];
const epJSON = (x) => JSON.stringify({ id: x.s.k + ':' + x.i, url: ausAudio(x.e.au), title: x.e.title, show: x.s.name, color: x.s.color, ink: x.s.feed === 'mixdj' ? '#141218' : '#FFFFFF', img: ausImg(x.e.img), s: x.e.s });
const when = (iso) => { const d = new Date(iso + 'Z'), t = new Date(); const diff = Math.round((new Date(t.getFullYear(), t.getMonth(), t.getDate()) - new Date(d.getFullYear(), d.getMonth(), d.getDate())) / 864e5); return diff <= 0 ? 'Aujourd’hui' : diff === 1 ? 'Hier' : diff < 7 ? `Il y a ${diff} jours` : dateShort(iso); };
const jour = (iso) => new Date(iso + 'Z').toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' });
// Les dernières publications, toutes émissions confondues.
const recents = all.slice(0, 6);
// Le fil de la matinale : les chroniques de cette journée, dans l'ordre de diffusion.
const fil = duJour.filter((x) => x.s.k !== 'morning').sort((a, b) => (a.e.d < b.e.d ? -1 : 1)).slice(0, 8);
// Une du magazine : les cinq derniers replays tournent en photo pleine page.
const une = h1 ? all.slice(0, 5) : [];
---
{h1 && (
  <section class="pzhero" data-full data-reveal>
    {une.map((x, i) => <img class:list={['hs pzh-im', { 'on kb-on': i === 0 }]} data-hs={i} src={ausImg(x.e.img, true)} alt="" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'low'} />)}
    <span class="pzh-sc" aria-hidden="true"></span>
    <div class="pzh-top">
      <p class="eb pzh-eb">{eyebrow}</p>
      <h1 class="pzh-h1"><span class="m"><span>Nos</span></span>{' '}<span class="m"><span style="font-weight:600">podcasts.</span></span></h1>
      <p class="pzh-lead">Plus de {pods.length} rendez-vous, à réécouter.</p>
    </div>
    <div class="pzh-b">
      <div class="pzh-ss">
        {une.map((x, i) => (
          <div class:list={['cap pzh-s', { on: i === 0 }]} data-cap={i}>
            <p class="pzh-k"><span class="live-dot" style={`background:${x.s.color}`}></span>{when(x.e.d)} · {x.s.name}</p>
            <p class="pzh-t">{x.e.title}</p>
            <p class="pzh-m">{x.s.sub} · {dur(x.e.s)}</p>
            <button class="pzh-play" type="button" data-rm-ep={epJSON(x)}><span class="pzfpi"><I n="play" /></span>Écouter l’épisode</button>
          </div>
        ))}
      </div>
      <div class="pzh-nav">
        {une.map((x, i) => <button type="button" data-hgo={i} aria-label={`Replay ${i + 1} : ${x.e.title}`}><span class:list={['bar', { on: i === 0 }]}><i></i></span><em>{x.s.name}</em></button>)}
      </div>
    </div>
  </section>
)}
  <section id="podcasts" data-reveal class:list={['pzs', { 'pzs-sub': h1 }]}>
    <div class="pzw2">

      <header class="pz-hd">
        {!h1 && <div class="pz-ti"><p class="eb">{eyebrow}</p><H class="pzh"><span class="m"><span>Entrez</span></span>{' '}<span class="m"><span style="font-weight:600">où vous voulez.</span></span></H></div>}
        <div class="pz-new">
          <p class="pz-newh">Dernières publications</p>
          <div class="pz-newr">
            {recents.map((x) => (
              <button class="pz-newc" type="button" data-rm-ep={epJSON(x)} data-epid={x.s.k + ':' + x.i}>
                <img src={ausImg(x.e.img)} alt="" loading="lazy" />
                <span class="pz-newx"><b>{x.e.title}</b><i>{x.s.name} · {when(x.e.d)}</i></span>
                <span class="pz-newp" aria-hidden="true"><I n="play" s={11} /></span>
              </button>
            ))}
          </div>
        </div>
      </header>

      {feat && (
        <div class="pz-ch">
          <div class="pz-chl">
            <button class="pz-chv" type="button" data-rm-ep={epJSON(feat)} aria-label={`Écouter : ${feat.e.title}`}>
              <img src={ausImg(feat.e.img, true)} alt="" loading="lazy" />
              <span class="pz-chp"><I n="play" s={24} /></span>
            </button>
            <p class="pz-chk"><span class="live-dot"></span>{feat.s.name} · {when(feat.e.d)}</p>
            <p class="pz-cht">{feat.e.title}</p>
            <p class="pz-chm">{feat.s.sub} · {dur(feat.e.s)}{fil.length > 0 && ` · ${fil.length} séquences`}</p>
            <button class="pz-chb" type="button" data-rm-ep={epJSON(feat)} data-epid={feat.s.k + ':' + feat.i}><span class="pzfpi"><I n="play" /></span><span data-f="cta">Écouter depuis le début</span></button>
          </div>
          <div class="pz-chr">
            <p class="pz-chh">Le fil de la matinale<span>{jour(feat.e.d)}</span></p>
            {fil.map((x, i) => (
              <button class="pz-seq" type="button" data-rm-ep={epJSON(x)} data-epid={x.s.k + ':' + x.i} style={`--c:${x.s.color}`}>
                <span class="pz-sqt">{String(i + 1).padStart(2, '0')}</span>
                <span class="pz-sqx"><b>{x.s.name}</b><span>{x.e.title}</span></span>
                <span class="pz-sqd">{dur(x.e.s)}</span>
                <span class="pz-sqp" aria-hidden="true"><I n="play" s={12} /></span>
              </button>
            ))}
            {fil.length === 0 && <p class="pz-sqv">Les chroniques de la journée paraissent au fil de la matinale.</p>}
          </div>
        </div>
      )}

      <div class="pz-tree">
        <p class="pz-treeh">Les {pods.length} rendez-vous<span>Classés par univers</span></p>
        <div class="pz-brs">
          {BRANCHES.map(([key, label, note, col, keys]) => {
            const items = keys.map((k) => byKey[k]).filter(Boolean);
            return items.length > 0 && (
              <div class="pz-br" style={`--c:${col}`}>
                <p class="pz-brh">{label}<i>{items.length}</i></p>
                <p class="pz-brn">{note}</p>
                <ul class="pz-brl">
                  {items.map((s) => <li><a href={u('/podcasts/' + s.k + '/')}><b>{s.name}</b><span>{s.sub}</span></a></li>)}
                </ul>
              </div>
            );
          })}
        </div>
        {more && <a href={u('/podcasts/')} class="pz-all">Tous les podcasts<I n="right" s={18} /></a>}
      </div>

    </div>
  </section>
